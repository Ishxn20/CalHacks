# Copy to .env (git-ignored). Everything is optional: with nothing set the console runs on its rule-based
# parser, typed input and on-screen replies.

# Claude: understands spoken requests (intent.py)
ANTHROPIC_API_KEY=
# SCRUB_CLAUDE_MODEL=claude-opus-5-5

# Cartesia: speech in (Ink) and out (Sonic)
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=            # default: the first voice on your account

# Convex: live dashboard. CONVEX_URL is public; CONVEX_DEPLOY_KEY must stay secret.
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Bitdeer AI Model Studio: case report and next-instrument suggestion
BITDEER_API_KEY=
# BITDEER_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Factory Droid: fault triage (also needs the `droid` CLI on PATH)
FACTORY_API_KEY=

# The arm server
SCRUB_API_TOKEN=               # required to listen off-loopback; the console sends it as a bearer token
# SCRUB_AUDIT_KEY=             # HMAC key for the audit log (forgery then needs the key)
# SCRUB_ARM_URL=http://127.0.0.1:8765
# SCRUB_PERCEPTION_URL=http://127.0.0.1:8770
